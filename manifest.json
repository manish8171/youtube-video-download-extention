{
  "manifest_version": 3,
  "name": "YouTube Video & MP3 Downloader",
  "version": "1.0.0",
  "description": "Download YouTube videos in MP4 format (HD/1080p/720p/360p) or extract MP3 audio directly from any YouTube watch page.",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "offscreen",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.googlevideo.com/*",
    "https://api.vidssave.com/*",
    "https://*.vidssave.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/main-world.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
